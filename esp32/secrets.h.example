// Device Certificate (from AWS IoT Core)
// Paste the contents of: xxxxxx-certificate.pem.crt
static const char AWS_CERT_CRT[] PROGMEM = R"KEY(
-----BEGIN CERTIFICATE-----
[PASTE YOUR DEVICE CERTIFICATE HERE]
-----END CERTIFICATE-----
)KEY";

// Device Private Key (from AWS IoT Core)
// Paste the contents of: xxxxxx-private.pem.key
static const char AWS_CERT_PRIVATE[] PROGMEM = R"KEY(
-----BEGIN RSA PRIVATE KEY-----
[PASTE YOUR DEVICE PRIVATE KEY HERE]
-----END RSA PRIVATE KEY-----
)KEY";
