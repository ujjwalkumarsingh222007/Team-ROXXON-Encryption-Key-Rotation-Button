# ==============================================================================
# ENCRYPTION KEY ROTATION BUTTON — CONFIGURATION TEMPLATE
# Copy this file to '.env' and fill in your AWS details for REAL KMS MODE.
# Default is Demo Mode (APP_MODE=demo) which requires NO AWS credentials.
# ==============================================================================

# Application Mode:
#   'demo' = Full simulation mode (safe default, zero AWS calls/cost)
#   'real' = Real AWS KMS on-demand key rotation (IoT/Lambda/ESP32 simulated)
APP_MODE=demo

# Flask Server Port & Host
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=True

# AWS Authentication & Region
# Provide credentials here or via ~/.aws/credentials / environment variables.
# NEVER commit your real credentials or .env file to git!
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional session token (for temporary lab credentials / AWS Academy / Learner Lab)
AWS_SESSION_TOKEN=

# AWS KMS Configuration
# Target Customer Managed Key ID (Direct Key ID in us-east-1):
KMS_KEY_ID=4f206dc3-dea4-4fcf-baee-8624627af374

# ESP32 Device Configuration (Simulated device identifier)
DEVICE_ID=ESP32-001
