# ==============================================================================
# ENCRYPTION KEY ROTATION BUTTON - CONFIGURATION TEMPLATE
# Copy this file to '.env' and fill in your AWS details when ready.
# ==============================================================================

# Application Mode: 'demo' (mock AWS) or 'real' (live AWS API calls)
APP_MODE=demo

# Flask Server Port & Host
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=True

# AWS Authentication & Region (Leave empty if using IAM Role on EC2 or Demo mode)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AWS KMS Configuration
# Paste your AWS KMS Customer Managed Key ID or ARN here
# Example: 12345678-1234-1234-1234-123456789012
KMS_KEY_ID=

# AWS IoT Core Configuration
# Paste your custom AWS IoT ATS Endpoint here
# Example: a1234567890abc-ats.iot.us-east-1.amazonaws.com
IOT_ENDPOINT=

# MQTT Topics
REQUEST_TOPIC=esp32/key_rotation/request
RESPONSE_TOPIC=esp32/key_rotation/response

# ESP32 Device Configuration
DEVICE_ID=ESP32-001
